# Local development loads Backend/.env. Set production values in Railway Variables.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=pmrmis-southcredtrack.site
DJANGO_FRONTEND_ORIGINS=https://your-school-hostname
CREDTRACK_FRONTEND_URL=https://your-school-hostname
# Keep your existing PostgreSQL connection values; no database configuration is replaced.
DB_NAME=credtrack
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5201
# Password reset email (never commit actual credentials)
EMAIL_HOST_PASSWORD=
# An absolute server-only directory; omit to use Backend/private_documents.
# PRIVATE_DOCUMENT_ROOT=C:\CredTrackPrivate\verification
# Keep existing Semaphore integration optional.
SMS_ENABLED=False
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-sender@gmail.com
DEFAULT_FROM_EMAIL=your-sender@gmail.com
FRONTEND_URL=https://pmrmis-southcredtrack.site
